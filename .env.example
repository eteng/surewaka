# ==============================================================================
# Neon (Postgres Database)
# Get these from: https://console.neon.tech → Project → Connection Details
# ==============================================================================
DATABASE_URL=postgresql://neondb_owner:your-password@ep-xxx-yyy.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ==============================================================================
# Clerk (Authentication)
# Get these from: https://dashboard.clerk.com → API Keys
# ==============================================================================
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
# Admin SPA (Vite-exposed)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# ==============================================================================
# Ably (Realtime — delivery tracking & driver location)
# Get these from: https://ably.com/accounts → App → API Keys
# ==============================================================================
ABLY_API_KEY=your-ably-api-key            # server-side only — full publish+subscribe
VITE_ABLY_SUBSCRIBE_KEY=your-subscribe-only-ably-key  # browser-safe — subscribe capability only (Ably dashboard → App → API Keys → add capability: subscribe)

# ==============================================================================
# Mapbox (Maps — delivery route + driver tracking)
# Get from: https://account.mapbox.com → Tokens → Create a token
# Use a public token (pk.*) — works for Maps GL + Directions API out of the box.
# Restrict it to your admin domain under "Allowed URLs" for production security.
# ==============================================================================
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token

# ==============================================================================
# Cloudinary (public image storage — avatars)
# Sign up at cloudinary.com → Dashboard → copy Cloud name, API Key, API Secret
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ==============================================================================
# Cloudflare R2 (private document storage — KYC docs, delivery photos)
# Cloudflare Dashboard → R2 → Create bucket "surewaka-private"
# R2 → Manage API Tokens → Create token with Object Read & Write
# Account ID is in the right sidebar of your Cloudflare dashboard
# ==============================================================================
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=surewaka-private

# ==============================================================================
# Redis
# ==============================================================================
REDIS_URL=redis://localhost:6379

# ==============================================================================
# Push Worker
# ==============================================================================
PUSH_WORKER_CONCURRENCY=5
PUSH_WORKER_HEALTH_PORT=4001
# Not yet polled by the admin Workers panel (only alert-engine is wired into
# apps/api/src/lib/worker-registry.ts today). If/when push-worker is added there,
# it'll default to http://surewaka-workers.internal:4001/health same as alert-engine —
# for local dev you'd add a PUSH_WORKER_HEALTH_URL=http://localhost:4001/health override then.

# ==============================================================================
# Matching Worker
# ==============================================================================
MATCHING_WORKER_HEALTH_PORT=4004
# Same caveat as push-worker above: not yet polled by the admin Workers panel.
# Was previously the shared HEALTH_PORT var (also used by routing-worker below) —
# renamed per-worker so setting one doesn't collide with the other, since both
# run as children of the same process in infra/docker/start-workers.sh.

# ==============================================================================
# Routing Worker
# ==============================================================================
ROUTING_WORKER_HEALTH_PORT=4003
# Same caveat as push-worker above: not yet polled by the admin Workers panel.
# Was previously the shared HEALTH_PORT var (also used by matching-worker above) —
# renamed per-worker so setting one doesn't collide with the other, since both
# run as children of the same process in infra/docker/start-workers.sh.

# ==============================================================================
# Alert Engine
# ==============================================================================
ALERT_ENGINE_HEALTH_PORT=4005
# apps/api's worker-registry.ts defaults to http://surewaka-workers.internal:4005/health,
# which only resolves inside Fly's private network. For local dev (API + alert-engine
# both running on your machine), uncomment this so the admin Workers panel can reach it:
# ALERT_ENGINE_HEALTH_URL=http://localhost:4005/health

# ==============================================================================
# AI / LLM
# ==============================================================================
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ==============================================================================
# Payments (Paystack for Nigeria)
# ==============================================================================
PAYSTACK_SECRET_KEY=sk_test_your-paystack-key
PAYSTACK_PUBLIC_KEY=pk_test_your-paystack-key

# ngrok — exposes local API so Paystack webhooks (charge.success, transfer.*)
# reach POST /api/v1/webhook/paystack during dev. Reserve a free static
# domain at https://dashboard.ngrok.com/domains, set it once in the Paystack
# dashboard (Settings > API Keys & Webhooks), and it never changes again.
# Leave blank to skip the tunnel — `pnpm dev` still runs fine without it.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# ==============================================================================
# Email (Resend)
# ==============================================================================
RESEND_API_KEY=re_your-resend-key

# ==============================================================================
# Landing Page — Pre-Launch Access Protection
# ==============================================================================
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USER=surewaka
BASIC_AUTH_PASSWORD=changeme

# ==============================================================================
# Expo (Mobile — EAS Project)
# ==============================================================================
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# ==============================================================================
# App URLs
# ==============================================================================
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ==============================================================================
# Finance cron — infrastructure cost providers
# ==============================================================================
CRON_FLY_TOKEN=
CRON_FLY_ORG_SLUG=surewaka
CRON_NEON_API_KEY=
CRON_NEON_PROJECT_ID=
CRON_VERCEL_TOKEN=
CRON_VERCEL_TEAM_ID=
CRON_CLERK_SECRET_KEY=   # same value as CLERK_SECRET_KEY — separate var for auditability
CRON_ABLY_API_KEY=       # same value as ABLY_API_KEY
ABLY_COST_PER_MILLION_MESSAGES_USD=0.25
