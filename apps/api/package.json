{
  "name": "@surewaka/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,tunnel -c blue,green \"tsx watch --env-file=../../.env --env-file=.env src/index.ts\" \"bash scripts/dev-webhook-tunnel.sh\"",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "create-superuser": "tsx --env-file=.env --env-file=../../.env ../../scripts/create-superuser.ts",
    "seed:bot-actors": "tsx --env-file=.env --env-file=../../.env scripts/seed-bot-actors.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@hono/node-server": "^1.13.0",
    "@hono/swagger-ui": "^0.6.1",
    "@surewaka/auth": "workspace:*",
    "@surewaka/db": "workspace:*",
    "@surewaka/realtime": "workspace:*",
    "@surewaka/shared": "workspace:*",
    "ably": "^2.6.0",
    "bullmq": "^5.34.8",
    "cloudinary": "^2.5.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "ioredis": "^5.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "fast-check": "^4.8.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
