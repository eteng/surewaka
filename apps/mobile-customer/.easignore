# EAS Build ignore — reduce upload size by excluding files not needed for the mobile build

# Native build outputs (regenerated by EAS)
/android
/ios

# Local env (EAS uses secrets configured in eas.json / dashboard)
.env
.env.local
.env.*.local

# Other apps (not needed for mobile-customer build)
apps/web
apps/admin
apps/landing
apps/api
apps/mobile-driver

# Workers (server-side only)
workers/

# AI agents (server-side only)
agents/

# Infrastructure & scripts
infra/
scripts/

# Documentation
docs/
*.md
!README.md

# Logs
logs/

# IDE & editor configs
.vscode/
.cursor/
.claude/
.idea/
.superpowers/
.playwright-mcp/
.worktrees/
.claire/

# Kiro / agent configs
.kiro/
.agents/

# Git
.git/

# Build caches
.turbo/
dist/
build/
coverage/
.react-router/

# Expo local state (regenerated)
.expo/

# Large/binary files not needed for build
*.zip
*.apk
*.aab
*.ipa

# Secrets & credentials (google-services.json intentionally NOT ignored — needed for FCM push)
*.pem
*.key
*.p12
*.keystore
service-account*.json
credentials*.json
surewaka-firebase-adminsdk-*.json

# Misc
*.log
*.tsbuildinfo
.DS_Store
Thumbs.db
.notion-startup-os.zip
red.md
